{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "新版",
  "version": "0.1.0",
  "identifier": "org.example.newgsp",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "新版", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 560, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["gsp"], "name": "原版课件", "description": "原版课件", "role": "Editor" },
      { "ext": ["ngsp"], "name": "新版课件", "description": "新版课件", "role": "Editor" }
    ],
    "windows": { "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser", "displayLanguageSelector": false } }
  }
}
