{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：核心 API；窗口只允许设置标题；dialog 只开“打开”和“另存为”；fs 只开读/写文件，且无静态路径范围（仅限用户在对话框中选中的文件）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
